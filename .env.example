EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Only needed if using an external proxy URL instead of standard Supabase Edge Functions
# EXPO_PUBLIC_VISION_PROXY_URL=https://<your-project-ref>.supabase.co/functions/v1/analyze-meal

# Crash reporting (Sentry). Without it the app runs normally, it just doesn't report crashes.
# Find it in Sentry: Project settings > Client Keys (DSN).
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>
